{
	"name": "n8n-nodes-kosa8",
	"version": "0.2.0",
	"description": "kosa8 Cloud sandboxes for n8n: run commands and move files in sealed microVMs",
	"license": "MIT",
	"homepage": "https://github.com/kosa8ai/n8n-nodes-kosa8#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"kosa8",
		"sandbox",
		"microvm",
		"ai-agents",
		"code-execution"
	],
	"author": {
		"name": "Kosa8 Labs",
		"email": "contact@kosa8.com",
		"url": "https://kosa8.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kosa8ai/n8n-nodes-kosa8.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Kosa8CloudApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Kosa8Cloud/Kosa8Cloud.node.js",
			"dist/nodes/Kosa8CloudTrigger/Kosa8CloudTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.57.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/kosa8ai/n8n-nodes-kosa8/issues"
	},
	"release-it": {
		"git": {
			"tagName": "v${version}"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
